# ============================================================
# BUSINESS PLAN GENERATOR - ENVIRONMENT CONFIGURATION
# ============================================================

# Spring Profile & Server
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database (Optional in dev, defaults to in-memory H2)
DATABASE_URL=jdbc:postgresql://localhost:5432/bpg_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Provider Configuration (Google Gemini & OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret
RAZORPAY_MOCK_MODE=true

# URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
